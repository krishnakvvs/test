pipeline {
  agent any

  options { timestamps() }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }
    stage('Build') {
      steps {
        sh '''
          echo "Building…"
          mkdir -p out
          echo "Hello from Jenkins $(date)" > out/build.txt
        '''
      }
    }
    stage('Test') {
      steps {
        sh 'echo "Running tests…"; sleep 1'
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'out/**', fingerprint: true
    }
    success { echo '✅ Done' }
    failure { echo '❌ Failed' }
  }
}
